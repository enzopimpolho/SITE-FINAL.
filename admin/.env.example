# Chave da Google Places API (New). Fica SÓ no servidor.
GOOGLE_MAPS_API_KEY=coloque_sua_chave_aqui
PORT=3000

# Acesso restrito ao painel admin (obrigatório em produção)
# Gere o hash com: npx tsx -e "import {hashSenha} from './server/auth';console.log(hashSenha('SUA_SENHA'))"
LEADJA_ADMIN_HASH=
LEADJA_SESSION_SECRET=
